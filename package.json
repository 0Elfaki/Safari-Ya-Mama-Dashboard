{
  "name": "safari-ya-mama-dashboard",
  "version": "2.0.0",
  "private": true,
  "description": "Safari ya Mama dashboard: medical staff monitoring and platform administration (Supabase).",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4174 --strictPort",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check:tokens": "node scripts/check-tokens.mjs",
    "qa": "node e2e/visual-qa.mjs",
    "sync:site": "node scripts/sync-site.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "zip": "node scripts/zip-dist.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.76.0",
    "@tiptap/extension-blockquote": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "clsx": "^2.1.1",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.68.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
